{
  "name": "website-qa",
  "version": "1.0.0",
  "description": "Automated website quality inspector",
  "main": "index.js",
  

"scripts": {
  "test": "npm run test:all",
  "test:unit": "vitest run src/index.test.ts",
  "test:integration": "start-server-and-test \"http-server test-site -p 8080\" http://127.0.0.1:8080 \"vitest run src/integration.test.ts\"",
  "test:all": "npm run test:unit && npm run test:integration"
},

